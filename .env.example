# --- Blackhole.Net configuration ---
#
# NOTE: .env only SEEDS the first run. After that, data/config.json is the
# source of truth and everything below is managed from the Admin panel in the
# UI. Editing these later has no effect unless you delete data/config.json.

# Optional: choose the first admin password instead of having one generated
# (the generated one is printed once to the container log on first start).
ADMIN_PASSWORD=


# Base URL of your Pi-hole (no trailing slash, no /admin, no /api).
# Use http:// unless you've enabled HTTPS on the Pi-hole.
PIHOLE_URL=

# Your Pi-hole web/admin password (the same one you use to log in to the
# Pi-hole admin interface). If your Pi-hole has no password, leave this blank.
PIHOLE_PASSWORD=

# Port this manager UI listens on locally.
PORT=3000

# Set to "true" only if your Pi-hole uses HTTPS with a self-signed certificate
# and requests are failing with certificate errors.
PIHOLE_INSECURE_TLS=false

# --- Gateway router (Gateway / internet-health section) ---
# Your router's LAN IP and a display label for its model.
GATEWAY_HOST=192.168.1.1
ROUTER_MODEL=

# --- Deep router integration (optional) ---
# Log in to the TP-Link gateway for live CPU/RAM, WAN, Wi-Fi and device data.
# Many ISP fiber gateways lock the "admin" account and expose "user" instead.
# Leave ROUTER_PASSWORD blank to disable the deep integration.
ROUTER_USERNAME=user
ROUTER_PASSWORD=

# Model driver. Leave blank to auto-detect. Pin one when detection fails —
# see the "Supported hardware" table in the README, or the Admin panel list.
# ISP-locked GPON gateways usually need: TPLinkEXClient
ROUTER_DRIVER=

# Vendor: tplink | asus | openwrt  (ROUTER_DRIVER only applies to tplink)
ROUTER_VENDOR=tplink

# --- Access points / extenders / switches (optional, up to 8) ---
# Each block adds one device to the Network Map, Wi-Fi Health and roaming
# tracking. DRIVER blank = auto-detect; see the README's supported-hardware
# table for the full list of model drivers.
AP1_HOST=
AP1_LABEL=AP 1
AP1_USERNAME=admin
AP1_PASSWORD=
AP1_DRIVER=
AP1_VENDOR=tplink

AP2_HOST=
AP2_LABEL=AP 2
AP2_USERNAME=admin
AP2_PASSWORD=
AP2_DRIVER=
AP2_VENDOR=tplink

# Poll intervals (seconds)
ROUTER_POLL_INTERVAL=20
AP_POLL_INTERVAL=45
